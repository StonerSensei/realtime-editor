# Copy this file to .env.local and fill in your values.

# ─── Development ──────────────────────────────────────────────────────────────
# Used server-side by next.config.mjs rewrites to proxy /api/* to the backend.
BACKEND_URL=http://localhost:8080

# ─── Browser / client-side ────────────────────────────────────────────────────
# MUST start with NEXT_PUBLIC_ so Next.js bundles it for the browser.
# Used for direct WebSocket connections (/yjs/*, /ws/*) which Next.js cannot proxy.
NEXT_PUBLIC_API_URL=http://localhost:8080

# ─── Production example ───────────────────────────────────────────────────────
# If frontend and backend share the same domain (via reverse proxy), leave
# NEXT_PUBLIC_API_URL empty and the code falls back to window.location.origin.
#
# If they are on different domains:
# NEXT_PUBLIC_API_URL=https://api.your-app.com
# BACKEND_URL=https://api.your-app.com
