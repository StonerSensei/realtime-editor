# Copy to `.env` and adjust. docker compose reads this automatically.
# Never commit the real .env (it is git-ignored).

# JWT signing secret - MUST be at least 32 characters. Generate a strong one:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Token lifetimes in milliseconds (optional; sensible defaults exist)
JWT_ACCESS_EXPIRATION=1800000     # 30 minutes
JWT_REFRESH_EXPIRATION=604800000  # 7 days
